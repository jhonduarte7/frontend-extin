# ==============================================================================
# Equi-Extin Frontend Environment Variables Template (.env.example)
#
# IMPORTANT:
# - Copy this file to '.env' or '.env.local' for local development.
# - In Vite, client-side exposed variables MUST begin with the prefix 'VITE_'.
# - NEVER store production secrets or private credentials in this file.
# ==============================================================================

# --- Backend REST & Streaming API Base URL ---
# Local development default:
VITE_API_URL=http://localhost:8090/api

# Production example (uncomment for production/staging builds):
# VITE_API_URL=https://api.venefast.com/api

# --- Application Configuration ---
VITE_APP_NAME=Equi-Extin ERP
VITE_DEFAULT_LANGUAGE=es
